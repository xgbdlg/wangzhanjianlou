{
  "manifest_version": 3,
  "name": "CSGOEmpire 捡漏助手",
  "version": "1.0.0",
  "description": "CSGOEmpire P2P 市场 + 拍卖实时监控与自动捡漏",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://csgoempire.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "ws://127.0.0.1:8081/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CSGOEmpire 捡漏助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
